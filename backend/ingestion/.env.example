# ═════════════════════════════════════════════════════════════════════════════
# .env.example — copy to .env and fill in the values marked "required".
#
#   • Every key below is read by config.py. Nothing here is decorative.
#   • Values shown are the defaults from config.py. Omit a line to use its default.
#   • NO SECRETS IN THIS FILE. It is committed to git. Real keys go in .env only.
#   • Keys must appear exactly once — python-dotenv silently takes the LAST one.
# ═════════════════════════════════════════════════════════════════════════════

# ── Qdrant (vector store) ────────────────────────────────────────────────────
QDRANT_HOST=localhost                   # required — hostname or IP of the Qdrant instance
QDRANT_PORT=6333                        # required — 6333 for local HTTP, 443 for hosted TLS
QDRANT_USE_TLS=false                    # true when connecting over HTTPS (hosted Qdrant)
QDRANT_TIMEOUT=30.0                     # seconds per Qdrant request
QDRANT_UPSERT_BATCH_SIZE=64             # points per bulk upsert (batched embed mode only)
QDRANT_ENABLED=true                     # false to skip the Qdrant collection check on startup
COLLECTION_KNOWLEDGE_BASE=              # required — Qdrant collection name for KB documents

# ── Embedding API ────────────────────────────────────────────────────────────
EMBED_API_URL=                          # required — base URL of the embedding server, no trailing slash
EMBED_API_KEY=                          # required — API key for the embedding server
EMBED_MODEL=Qwen3-Embedding-4B          # required — model name sent in the request body
EMBED_DIMS=2560                         # vector dimensions; MUST match the collection schema
EMBED_TIMEOUT=180.0                     # seconds to wait for one embedding response
EMBED_MAX_TOKENS=512                    # per-text token cap; keep ≥ INGESTION_CHUNK_SIZE or text is truncated
EMBED_BATCHING=true                     # true: token-capped batches; false: one chunk per API call
EMBED_BATCH_MAX_TOKENS=2048             # max total tokens per batched call (≤ model context 2048)

# ── Ingestion — concurrency ──────────────────────────────────────────────────
# Worker threads for the chunk AND embed stages. Both stages run at once and both
# call the embed server, so peak in-flight requests is up to 2×. Raise for a GPU
# server; high values overwhelm a CPU embed server (dropped connections).
INGEST_CONCURRENCY=8

# ── Ingestion — chunking ─────────────────────────────────────────────────────
CHUNKING_STRATEGY=hybrid                # hybrid (recursive tables + semantic prose) | recursive
INGESTION_CHUNK_SIZE=512                # target chunk size in tokens (Qwen tokenizer); ≤ EMBED_MAX_TOKENS
INGESTION_CHUNK_OVERLAP=100             # token overlap between adjacent chunks
INGESTION_MIN_CHUNK_SIZE=20             # tokens; chunks ≤ this are merged into the next
INGESTION_SEMANTIC_BREAKPOINT_PERCENTILE=85   # hybrid only — percentile threshold for semantic splits

# ── Calculum API (supplier/spend sync) ───────────────────────────────────────
CALCULUM_API_URL=                       # required for sync — base URL of the Calculum data API
CALCULUM_API_KEY=                       # required for sync — API key
CALCULUM_API_TIMEOUT=30.0               # seconds per API request
CALCULUM_API_MAX_RETRIES=3              # retry attempts per failed request
CALCULUM_API_PAGE_LIMIT=100             # rows requested per page (NOT a cap on total pages)

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false                 # true to run the sync pipeline periodically
SYNC_INTERVAL_MINUTES=180               # how often the full sync runs (minutes)

# ── Document storage (original uploaded files) ───────────────────────────────
STORAGE_TYPE=local                      # local | gcp
LOCAL_STORAGE_DIR=data/documents        # base dir when STORAGE_TYPE=local
GCS_BUCKET=                             # required when STORAGE_TYPE=gcp — bucket name
GCS_CREDENTIALS_PATH=                   # service-account JSON path; empty = ADC/Workload Identity

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DSN=                           # required — e.g. postgresql://user:password@host:5432/dbname
POSTGRES_POOL_SIZE=10                   # pooled connections
POSTGRES_MAX_OVERFLOW=0                 # extra connections above the pool; 0 = requests wait instead
POSTGRES_CONNECT_TIMEOUT=10.0           # seconds to wait for a connection before failing fast

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                             # required — HS256 secret; must match the issuing service
JWT_EXPIRY_HOURS=24                     # token lifetime in hours
ALGORITHM=HS256                         # JWT signing algorithm

# ── SSE (document-status stream) ─────────────────────────────────────────────
SSE_IDLE_TIMEOUT=15.0                   # seconds between heartbeats on an idle stream
SSE_MAX_CACHED=1024                     # retained last-events; bounds memory for unsubscribed files
SSE_MAX_QUEUE=64                        # per-subscriber backlog cap; bounds a dead/slow client

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                         # text (human-readable) | json (for log aggregators)
DEBUG=false                             # true logs every SQL statement — local only, never production
UPLOADED_BY=                            # required — global_users.uuid credited as uploader of ingested documents

# ── Evaluation (optional; only for scripts/eval and tests/integration) ───────
LLM_BASE_URL=                           # gates tests/integration/test_ragas_metrics.py
EVAL_LLM_API_KEY=                       # key for Ragas scoring — must be EXPORTED, not just set here
EVAL_LLM_MODEL=                         # model used for eval metric scoring
EVAL_EMBED_MODEL=                       # embedding model used for RAGAS metric scoring
