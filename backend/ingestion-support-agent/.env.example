# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in the required values.
# Lines starting with # are comments. Values marked "required" must be set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Qdrant (vector store) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost           # hostname or IP of the Qdrant instance
QDRANT_PORT=6333                # gRPC/REST port (default 6333)
# QDRANT_API_KEY=               # required when Qdrant is running with API key auth
# QDRANT_USE_TLS=false          # set true when connecting over HTTPS

COLLECTION_KNOWLEDGE_BASE=      # required — Qdrant collection name for KB documents
QDRANT_UPSERT_BATCH_SIZE=32     # points per bulk upsert (used in batched embed mode)

# ── Embedding API ─────────────────────────────────────────────────────────────
EMBED_API_URL=                  # required — base URL of the hosted embedding server (no trailing slash)
EMBED_API_KEY=                  # required — bearer token for the embedding API
EMBED_MODEL=Qwen3-Embedding-4B  # model name sent in the request body
EMBED_DIMS=2560                 # output vector dimensions; must match the collection schema
EMBED_TIMEOUT=180.0             # seconds to wait for a single embedding response (GPU: ~123 ms avg)
EMBED_MAX_TOKENS=512            # hard per-text token cap; model context window is 2048
EMBED_BATCH_MAX_TOKENS=2048     # max total tokens per batched call (≤ model context 2048)

# ── Calculum API ──────────────────────────────────────────────────────────────
CALCULUM_API_URL=               # required — base URL for the Calculum data API
CALCULUM_API_KEY=               # required — API key for authenticating with Calculum

# ── Scheduler (spend/supplier sync) ──────────────────────────────────────────
SCHEDULER_ENABLED=false         # set true to enable automatic periodic sync
SYNC_INTERVAL_MINUTES=180       # how often the full sync runs (minutes); default 3 h

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DSN=                   # required — e.g. postgresql://user:password@host:5432/dbname
POSTGRES_CONNECT_TIMEOUT=10.0   # seconds to wait for a DB connection before failing fast

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                 # text (human-readable) | json (structured, for log aggregators)
UPLOADED_BY=                    # required — global_users.uuid assigned as the uploader of ingested documents

# ── Ingestion — concurrency ───────────────────────────────────────────────────
EMBED_BATCHING=false            # true: pack chunks into token-capped batches; false: one chunk per API call
INGEST_CONCURRENCY=16           # worker threads for BOTH chunk and embed stages; raise for a GPU embed server

# ── Ingestion — chunking ──────────────────────────────────────────────────────
CHUNKING_STRATEGY=hybrid        # hybrid (default) = recursive tables + semantic prose | recursive
INGESTION_CHUNK_SIZE=512        # target chunk size in tokens (Qwen tokenizer); ≤ model context 2048
INGESTION_CHUNK_OVERLAP=100     # token overlap between adjacent chunks to preserve context
INGESTION_SEMANTIC_BREAKPOINT_PERCENTILE=85   # hybrid only — percentile threshold for semantic splits
INGESTION_TRANSCRIPT_CHUNK_MS=40000           # transcript chunks target this wall-clock window (ms) for tight start/end
INGESTION_TRANSCRIPT_OVERLAP_CUES=1           # whole cues shared between adjacent transcript chunks

# ── Auth (video upload + transcript ingest are superadmin-only) ───────────────
# Standalone / calculum-tokenize path (HS256, shared secret). Without this set,
# the Authorization: Bearer fallback can never succeed.
JWT_SECRET=                     # required for the standalone Bearer path — shared HS256 signing secret
# Ada Bot / Azure B2C path (RS256, JWKS). Leave these three empty ONLY in local dev —
# if unset in a deployed environment, the __Secure-auth_session-token cookie is parsed
# but silently ignored (verification always no-ops), so requests fall straight through
# to the Bearer path and get a 401 even though a valid cookie was sent.
AZURE_JWKS_URL=                 # required for cookie auth — parent app's JWKS discovery URL
AZURE_B2C_ISSUER=               # required for cookie auth — expected `iss` claim
AZURE_B2C_AUDIENCE=             # required for cookie auth — expected `aud` claim
AZURE_AUTH_COOKIE_NAME=__Secure-auth_session-token  # optional; this is the default

# ── CORS (browser frontend) ───────────────────────────────────────────────────
# Comma-separated origins allowed to call this API from a browser. Add your frontend
# dev/staging/prod origins. Not needed if the frontend calls via a same-origin dev proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8081,https://calculum-ui-staging-790888106252.us-central1.run.app,https://calculum-ui-staging-yu3o33nplq-uc.a.run.app, ,https://dev-app.hello-ada.com
# ── GCS bucket layout ─────────────────────────────────────────────────────────
# One bucket with three folders. Transcripts are stored under the SAME id as their video.
GCP_STORAGE_BUCKET=calculum-support-agent-videos
GCP_STORAGE_PREFIX=videos            # videos/<video_id>.mp4
GCP_TRANSCRIPT_PREFIX=transcripts    # transcripts/<video_id>.<ext>
GCP_DOCUMENT_PREFIX=documents        # documents/<document_id>.<ext>

# ── Direct video upload (signed URL) + managed compression (Transcoder API) ────
GCP_UPLOAD_BUCKET=calculum-support-agent-uploads  # SEPARATE bucket for direct-uploaded originals (empty = reuse GCP_STORAGE_BUCKET)
GCP_UPLOAD_STAGING_PREFIX=uploads         # folder within the upload bucket for originals
VIDEO_UPLOAD_URL_TTL_SECONDS=3600         # signed upload URL lifetime
GCP_SIGNING_SERVICE_ACCOUNT=              # SA email to sign as under ADC (needs Token Creator); empty if using a SA key
GCP_TRANSCODER_LOCATION=us-central1
GCP_TRANSCODER_PUBSUB_TOPIC=              # projects/<p>/topics/<t> — Transcoder job-completion events
VIDEO_COMPRESS_ENABLED=false             # DEFAULT false = skip compression entirely; every video uploads to videos/ as-is (any size, no Transcoder job). Set true ONLY after the Transcoder completion webhook is verified, else videos ≥ VIDEO_COMPRESS_MIN_BYTES stall at "compressing".
VIDEO_COMPRESS_MIN_BYTES=52428800        # skip compression below this (50 MB); store the original as-is (CRF would inflate small files)
VIDEO_TRANSCODE_BITRATE_BPS=8000000      # H.264 bitrate ceiling (Transcoder requires it even in CRF mode)
PUBSUB_AUDIENCE=                          # expected OIDC audience on the Pub/Sub push webhooks (verify in prod)
