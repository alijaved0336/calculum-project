shamefully-hoist=true
strict-peer-dependencies=false

# Azure Artifacts feed — hosts our private calculum-ui package only. calculum-ui is
# pinned to a direct tarball URL in apps/ap/package.json instead of a registry=
# override, so every other (public) dependency resolves from the public npm registry
# directly and never depends on this feed's upstream-proxy cache being warm.
#
# PAT comes from the CALCULUM_FEED_PAT environment variable (set on the deployed
# server/pipeline). For local installs, export CALCULUM_FEED_PAT in your shell first.
//pkgs.dev.azure.com/calculum/AI%20Negotiation/_packaging/calculum-packages/npm/registry/:_authToken=${CALCULUM_FEED_PAT}
//pkgs.dev.azure.com/calculum/AI%20Negotiation/_packaging/calculum-packages/npm/registry/:always-auth=true
