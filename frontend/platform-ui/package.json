{
  "name": "ada-frontend",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "postinstall": "kendo-ui-license activate --ignore-no-license",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:ap": "turbo run dev --filter=@ada/ap",
    "dev:ar": "turbo run dev --filter=@ada/ar",
    "dev:apv2": "turbo run dev --filter=@ada/apv2",
    "build:ap": "turbo run build --filter=@ada/ap",
    "build:ar": "turbo run build --filter=@ada/ar",
    "build:apv2": "turbo run build --filter=@ada/apv2",
    "dev:storybook": "turbo run dev --filter=@ada/design-system",
    "storybook": "pnpm --filter @ada/design-system storybook",
    "build-storybook": "pnpm --filter @ada/design-system build-storybook",
    "update:calculum-ui": "node scripts/update-calculum-ui.mjs",
    "calculum-ui:versions": "pnpm view calculum-ui versions --registry=\"https://pkgs.dev.azure.com/calculum/AI Negotiation/_packaging/calculum-packages/npm/registry/\""
  },
  "devDependencies": {
    "@progress/kendo-licensing": "^1.11.2",
    "turbo": "^2.10.4"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<3.15.0": ">=3.15.0 <4.0.0",
      "js-yaml@>=3.0.0 <3.15.0": ">=3.15.0 <4.0.0",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0 <5.0.0",
      "websocket-driver@<0.7.5": ">=0.7.5 <0.8.0",
      "brace-expansion@<1.1.21": ">=1.1.21 <2.0.0",
      "brace-expansion@>=2.0.0 <2.1.7": ">=2.1.7 <3.0.0",
      "brace-expansion@>=3.0.0 <5.0.12": ">=5.0.12 <6.0.0",
      "shell-quote@<=1.8.4": ">=1.9.0 <2.0.0",
      "protobufjs@>=7.5.0 <=7.6.4": ">=7.6.5 <8.0.0",
      "axios@>=1.0.0 <1.20.0": ">=1.20.0 <2.0.0",
      "@apollo/client": "^3.13.8",
      "js-cookie@<=3.0.5": ">=3.0.7 <4.0.0",
      "dompurify@<=3.4.15": ">=3.4.16 <4.0.0",
      "nanoid@<3.3.17": ">=3.3.17 <4.0.0",
      "js-yaml@>=3.0.0 <3.15.2": ">=3.15.2 <4.0.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5.0.0",
      "qs@>=6.0.0 <6.16.0": ">=6.16.0 <7.0.0",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6 <4.0.0",
      "markdown-it@>=14.0.0 <14.3.1": ">=14.3.1 <15.0.0",
      "probe-image-size@>=7.0.0 <=7.3.0": ">=7.4.0 <8.0.0"
    }
  }
}