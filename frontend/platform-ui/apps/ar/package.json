{
  "name": "@ada/ar",
  "version": "0.1.0",
  "versionDate": "08/06/2026",
  "private": true,
  "scripts": {
    "dev":       "vite --port 8082",
    "build":     "vite build",
    "preview":   "vite preview --port 8092",
    "lint":      "eslint src --ext .ts,.tsx,.vue",
    "typecheck": "vue-tsc --noEmit",
    "test":      "vitest run",
    "e2e:run":   "playwright test",
    "e2e:run:headed": "playwright test --headed",
    "e2e:report":     "npx playwright show-report",
    "postinstall": "kendo-ui-license activate --ignore-no-license || echo \"AR: Kendo license activation failed; continuing. Licensed builds need a valid KENDO_UI_LICENSE (G-62).\""
  },
  "dependencies": {
    "@ada/auth":          "workspace:*",
    "@ada/core":          "workspace:*",
    "@ada/design-system": "workspace:*",
    "@apollo/client":     "^3.13.8",
    "graphql":            "^16.9.0",
    "@progress/kendo-data-query":      "^1.7.0",
    "@sentry/vue":        "^9.34.0",
    "@progress/kendo-drawing":         "^1.25.3",
    "@progress/kendo-licensing":       "^1.11.2",
    "@progress/kendo-theme-bootstrap": "^7.2.1",
    "@progress/kendo-vue-charts":      "^9.0.0",
    "@progress/kendo-vue-grid":        "^9.0.0",
    "pinia":              "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "secure-ls":          "^2.0.0",
    "uuid-random":        "^1.3.2",
    "vue":                "^3.5.17",
    "vue-i18n":           "^9.9.1",
    "vue-router":         "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-blocks-tree":   "^0.6.2"
  },
  "devDependencies": {
    "@playwright/test":             "^1.46.0",
    "@sentry/vite-plugin":          "^2.23.1",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser":    "^7.1.1",
    "@vitejs/plugin-vue":           "^5.0.4",
    "@vue/compiler-sfc":            "^3.5.17",
    "@vue/test-utils":              "^2.4.6",
    "eslint":                       "^8.56.0",
    "eslint-config-prettier":       "^9.1.0",
    "eslint-plugin-vue":            "^9.21.1",
    "typescript":                   "~5.3.3",
    "vite":                         "^6.4.1",
    "vite-plugin-vue-devtools":     "^7.7.10",
    "vitest":                       "^3.2.4",
    "vue-tsc":                      "^2.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/base",
      "plugin:vue/vue3-essential",
      "plugin:vue/vue3-recommended",
      "prettier"
    ],
    "plugins": [
      "@typescript-eslint"
    ],
    "parser": "vue-eslint-parser",
    "parserOptions": {
      "parser": "@typescript-eslint/parser",
      "sourceType": "module",
      "ecmaVersion": 2022
    },
    "rules": {
      "space-before-function-paren": [
        0
      ],
      "@typescript-eslint/explicit-module-boundary-types": "off",
      "@typescript-eslint/no-explicit-any": "off"
    }
  }
}
