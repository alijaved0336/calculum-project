        "dotenv": "^16.4.5",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-boundaries": "^6.0.2",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-promise": "^6.1.1",
        "eslint-plugin-standard": "^5.0.0",
        "eslint-plugin-vue": "^9.21.1",
        "happy-dom": "^20.3.0",
        "http-server": "^14.1.1",
        "jsdom": "^24.0.0",
        "less": "^4.2.0",
        "less-loader": "^11.1.3",
        "madge": "^8.0.0",
        "npm-run-all": "^4.1.5",
        "prettier": "3.3.3",
        "sass": "^1.72.0",
        "sass-loader": "^14.1.0",
        "typedoc": "^0.28.10",
        "typescript": "~5.3.3",
        "vite": "^6.4.1",
        "vite-plugin-vue-devtools": "^7.7.10",
        "vitest": "^3.2.4",
        "vue-tsc": "^2.0.0"
    },
    "overrides": {
        "crypto-js": "^4.2.0",
        "serialize-javascript": "^7.0.5"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true
        },
        "extends": [
            "plugin:vue/base",
            "plugin:vue/vue3-essential",
            "plugin:vue/vue3-recommended",
            "prettier"
        ],
        "plugins": [
            "boundaries"
        ],
        "settings": {
            "boundaries/elements": [
                {
                    "type": "app",
                    "pattern": "apps/ap/src/**"
                },
                {
                    "type": "package",
                    "pattern": "packages/*/src/**"
                }
            ]
        },
        "parser": "vue-eslint-parser",
        "parserOptions": {
            "parser": "@typescript-eslint/parser",
            "sourceType": "module",
            "ecmaVersion": 2022
        },
        "rules": {
            "space-before-function-paren": [
                0
            ],
            "@typescript-eslint/explicit-module-boundary-types": "off",
            "@typescript-eslint/no-explicit-any": "off",
            "no-restricted-imports": [
                "error",
                {
                    "paths": [
                        {
                            "name": "@/utils/FormatData",
                            "importNames": [
                                "formatBigNumbers"
                            ],
                            "message": "Use StringUtils.formatBigNumbers (pure) or StringUtils.formatBigCurrency (with currency conversion) instead. See docs/superpowers/plans/2026-05-01-currency-format-consolidation.md."
                        }
                    ]
                }
            ],
            "no-restricted-syntax": [
                "error",
                {
                    "selector": "MemberExpression[object.name=/^(formatData|FormatData)$/][property.name='formatBigNumbers']",
                    "message": "Use StringUtils.formatBigNumbers or StringUtils.formatBigCurrency instead."
                }
            ],
            "boundaries/element-types": [
                "warn",
                {
                    "default": "allow",
                    "rules": [
                        {
                            "from": "package",
                            "disallow": [
                                "app"
                            ],
                            "message": "Shared packages must not import from app-specific code. Move shared code to a package instead."
                        }
                    ]
                }
            ]
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ]
}