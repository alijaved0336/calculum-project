    "private": true,
    "scripts": {
        "dev": "vite --port 8081",
        "build": "vite build",
        "build:serve": "http-server --port 9090 .\\dist\\",
        "lint": "eslint src --ext .ts,.tsx,.vue",
        "typecheck": "vue-tsc --noEmit",
        "e2e:serve": "run-s build build:serve",
        "e2e:run": "playwright test",
        "e2e:run:ci": "playwright test --quiet",
        "e2e:run:headed": "playwright test --headed",
        "e2e:run:debug": "playwright test --debug",
        "e2e:report": "npx playwright show-report",
        "e2e:codegen": "playwright codegen http://localhost:8081",
        "e2e:codegenlocal": "playwright codegen http://localhost:8081",
        "env:test": "cross-env test_env=test npx playwright test",
        "env:test-pr": "cross-env test_env=test npx playwright test --grep '@prq'",
        "env:test-partial": "cross-env test_env=test npx playwright test --grep-invert '@heavy'",
        "env:prod": "cross-env test_env=prod npx playwright test",
        "env:local": "cross-env test_env=local npx playwright test",
        "env:dev": "cross-env test_env=dev npx playwright test",
        "test": "vitest",
        "test:unit": "vitest run tests/Unit",
        "test:component": "vitest run tests/Component tests/Composables",
        "test:integration": "vitest run tests/Integration",
        "test:ci": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test:watch": "vitest watch",
        "docs": "typedoc"
    },
