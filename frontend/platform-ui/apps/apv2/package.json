{
  "name": "@ada/apv2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":       "vite --port 8081",
    "build":     "vite build",
    "preview":   "vite preview --port 8093",
    "lint":      "eslint src --ext .ts,.tsx,.vue",
    "typecheck": "vue-tsc --noEmit",
    "test":      "vitest",
    "e2e:run":        "playwright test",
    "e2e:run:headed": "playwright test --headed",
    "e2e:report":     "npx playwright show-report"
  },
  "dependencies": {
    "@ada/auth":          "workspace:*",
    "@ada/core":          "workspace:*",
    "@ada/design-system": "workspace:*",
    "pinia":              "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "secure-ls":          "^2.0.0",
    "uuid-random":        "^1.3.2",
    "vue":                "^3.5.17",
    "vue-i18n":           "^9.9.1",
    "vue-router":         "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@playwright/test":                   "^1.46.0",
    "@sentry/vite-plugin":                "^2.23.1",
    "@typescript-eslint/eslint-plugin":   "^7.1.1",
    "@typescript-eslint/parser":          "^7.1.1",
    "@vitejs/plugin-vue":                 "^5.0.4",
    "@vue/compiler-sfc":                  "~3.2.13",
    "eslint":                             "^8.56.0",
    "eslint-plugin-vue":                  "^9.21.1",
    "typescript":                         "~5.3.3",
    "vite":                               "^6.4.1",
    "vite-plugin-vue-devtools":           "^7.7.10",
    "vitest":                             "^3.2.4",
    "vue-tsc":                            "^2.0.0"
  }
}
